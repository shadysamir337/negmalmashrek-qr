# Firebase web app config.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Must match the admin email in firestore.rules.
VITE_ADMIN_EMAIL=admin@360qr.com

# Optional: enable Firebase App Check using reCAPTCHA v3.
#
# How to get a key:
# 1. In Firebase Console -> App Check -> Apps -> click your web app
# 2. Choose "reCAPTCHA v3" as the provider
# 3. Click "Register" -- this opens a Google reCAPTCHA console
# 4. Create a reCAPTCHA v3 key for your domain (localhost is auto-allowed in dev)
# 5. Copy the SITE KEY (NOT the secret) and paste it below
# 6. Rename this file to `.env` and restart `npm run dev`
#
# Until you set this, the app runs without App Check (still secured by
# Firebase Auth + Firestore rules).
VITE_RECAPTCHA_V3_SITE_KEY=
